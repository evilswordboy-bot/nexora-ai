# ==========================================
# NEXORA AI — Environment Configuration Template
# ==========================================

HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Model Providers
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-1.5-flash

# Universal Search & Deep Research
DEFAULT_SEARCH_ENGINE=auto
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
MAX_SEARCH_RESULTS=5
MAX_RESEARCH_SOURCES=8
SCRAPER_TIMEOUT_SECONDS=8.0

# Document Intelligence & Knowledge Engine (Stage 4)
DOCUMENT_STORAGE_DIR=data/documents
MAX_UPLOAD_SIZE_BYTES=26214400
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
TOP_K_CHUNKS=5
TESSERACT_CMD=

# Voice Intelligence Engine (Stage 7)
DEFAULT_VOICE_ID=browser_default
DEFAULT_VOICE_SPEED=1.0
AUTO_SPEAK_AI_RESPONSES=false

# Real-Time Intelligence Engine (Stage 8)
REALTIME_CACHE_TTL_SECONDS=300
DEFAULT_MONITOR_INTERVAL_MINUTES=60
MAX_LIVE_SOURCES=6

# Computer Vision & Visual Intelligence Engine (Stage 9)
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_ATTACHED_IMAGES_PER_REQUEST=5
QUARANTINE_OCR_TEXT=true

MAX_CONTEXT_MESSAGES=20
MAX_MESSAGE_CHARS=32000
REQUEST_TIMEOUT_SECONDS=45.0

RATE_LIMIT_PER_MINUTE=60
ENABLE_SAFETY_GUARDRAILS=true

# Universal Travel & Ticket Booking (Stage 29)
TRAVEL_DB_PATH=data/travel/nexora_travel.db
TRAVEL_CACHE_TTL_SECONDS=300
TRAVEL_HOLD_DURATION_MINUTES=15
TRAVEL_DEFAULT_CURRENCY=USD
TRAVEL_MAX_PASSENGERS=9
TRAVEL_ALLOW_SANDBOX_BOOKING=true



