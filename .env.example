# ==========================================
# NEXORA AI — Environment Configuration Template
# Copy this file to .env and configure your keys.
# ==========================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Provider API Keys (Leave blank if not configured yet; Nexora will report honest unconfigured status)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default Active Model & Provider (auto | gemini | openai | anthropic)
DEFAULT_PROVIDER=auto
DEFAULT_MODEL=gemini-1.5-flash

# Stage 3: Universal Search & Deep Research
DEFAULT_SEARCH_ENGINE=auto
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
MAX_SEARCH_RESULTS=5
MAX_RESEARCH_SOURCES=8
SCRAPER_TIMEOUT_SECONDS=8.0

# Stage 4: Document Intelligence & Knowledge Engine
DOCUMENT_STORAGE_DIR=data/documents
MAX_UPLOAD_SIZE_BYTES=26214400
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
TOP_K_CHUNKS=5
TESSERACT_CMD=

# Stage 7: Voice Intelligence Engine
DEFAULT_VOICE_ID=browser_default
DEFAULT_VOICE_SPEED=1.0
AUTO_SPEAK_AI_RESPONSES=false

# Stage 8: Real-Time Intelligence Engine
REALTIME_CACHE_TTL_SECONDS=300
DEFAULT_MONITOR_INTERVAL_MINUTES=60
MAX_LIVE_SOURCES=6

# Stage 9: Computer Vision & Visual Intelligence Engine
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_ATTACHED_IMAGES_PER_REQUEST=5
QUARANTINE_OCR_TEXT=true

# Stage 11: Advanced Reasoning Engine
REASONING_MAX_RETRIES=2
REASONING_TOOL_TIMEOUT_SECONDS=15.0
REQUIRE_APPROVAL_FOR_CONSEQUENTIAL_TOOLS=true

# Stage 12: Intelligent Model Routing & Cost Controls
DEFAULT_ROUTING_MODE=balanced
MAX_ROUTING_FALLBACKS=2
DAILY_SPENDING_LIMIT_USD=10.0
PER_REQUEST_MAX_COST_USD=0.50
ROUTING_TIMEOUT_SECONDS=30.0

# Stage 13: Persistent Memory Engine & Privacy Controls
MEMORY_DB_PATH=data/memory/nexora_memory.db
MEMORY_ENABLED_BY_DEFAULT=true
MEMORY_ENCRYPTION_SECRET=nexora-stage13-local-encryption-key
MAX_MEMORIES_PER_USER=500
TOP_K_MEMORIES=5

# Stage 14: Multi-Agent Intelligence System
AGENT_MAX_STEPS_PER_TASK=6
AGENT_MAX_PARALLEL_TASKS=3
AGENT_TASK_TIMEOUT_SECONDS=25.0
AGENT_MAX_COST_USD_PER_RUN=0.25

# Stage 15: Workflow Automation Engine
WORKFLOW_DB_PATH=data/workflows/nexora_workflows.db
WORKFLOW_MAX_STEPS=15
WORKFLOW_MAX_STEP_RETRIES=3
WORKFLOW_STEP_TIMEOUT_SECONDS=30.0
WORKFLOW_MAX_COST_USD_PER_RUN=0.50
WORKFLOW_RATE_LIMIT_PER_MINUTE=20
WORKFLOW_SCHEDULER_POLL_SECONDS=15.0
NOTIFICATION_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Stage 16: Computer Control & Digital Execution Engine
COMPUTER_WORKSPACE_DIR=data/computer_workspace
COMPUTER_DB_PATH=data/computer_workspace/nexora_computer.db
COMPUTER_MAX_STEPS_PER_TASK=12
COMPUTER_STEP_TIMEOUT_SECONDS=20.0
COMPUTER_ENABLE_LOCAL_OS_RUNNER=true
COMPUTER_STRICT_URL_ALLOWLIST=false
COMPUTER_ALLOWED_DOMAINS=example.com,wikipedia.org,en.wikipedia.org,github.com,python.org,fastapi.tiangolo.com,developer.mozilla.org,news.ycombinator.com

# Stage 17: File Management & Workspace Automation Engine
FILE_WORKSPACE_DIR=data/file_workspace
FILE_WORKSPACE_DB_PATH=data/file_workspace/nexora_files.db
FILE_WORKSPACE_MAX_FILE_SIZE_BYTES=10485760
FILE_WORKSPACE_MAX_BULK_FILES=50
FILE_WORKSPACE_BULK_APPROVAL_THRESHOLD=3
FILE_WORKSPACE_MAX_VERSIONS_PER_FILE=10

# Stage 18: Terminal & Code Execution Engine
TERMINAL_WORKSPACE_DIR=data/terminal_workspace
TERMINAL_DB_PATH=data/terminal_workspace/nexora_terminal.db
TERMINAL_EXECUTION_TIMEOUT_SECONDS=5.0
TERMINAL_MAX_OUTPUT_BYTES=65536
TERMINAL_MAX_MEMORY_MB=128
TERMINAL_MAX_PROCESSES=4
TERMINAL_MAX_CONCURRENT_RUNS_PER_USER=3
TERMINAL_MAX_REPAIR_ATTEMPTS=3
TERMINAL_DEFAULT_ALLOW_NETWORK=false

# Stage 19: Git & Version Control Engine
GIT_DB_PATH=data/terminal_workspace/nexora_git.db
GIT_DEFAULT_AUTHOR_NAME=Nexora AI Developer
GIT_DEFAULT_AUTHOR_EMAIL=developer@nexora.local
GIT_DEFAULT_BRANCH=main
GIT_COMMAND_TIMEOUT_SECONDS=10.0
GIT_PROVIDER_TOKEN=
GIT_ALLOWED_REMOTE_HOSTS=github.com,gitlab.com,bitbucket.org

# Stage 20: AI Evaluation & Quality Assurance Engine
EVAL_WORKSPACE_DIR=data/evaluation
EVAL_DB_PATH=data/evaluation/nexora_eval.db
EVAL_MIN_TASK_SUCCESS_RATE=0.80
EVAL_MIN_SAFETY_COMPLIANCE_RATE=1.0
EVAL_MAX_ERROR_RATE=0.20
EVAL_MAX_LATENCY_REGRESSION_PCT=100.0
EVAL_BLOCK_ON_CRITICAL_FAILURE=true
EVAL_EXCLUDE_PRIVATE_CONVERSATIONS=true

# Stage 21: Universal Knowledge Discovery Engine
DISCOVERY_CACHE_TTL_SECONDS=600
DISCOVERY_CONNECTOR_TIMEOUT_SECONDS=8.0
DISCOVERY_MAX_PARALLEL_CONNECTORS=6
DISCOVERY_DEFAULT_PAGE_SIZE=10
DISCOVERY_MAX_PAGE_SIZE=30
DISCOVERY_STALE_DAYS_THRESHOLD=365
DISCOVERY_ENABLE_LIVE_ACADEMIC_API=true

# Stage 22: Knowledge Graph Intelligence Engine
KG_DB_PATH=data/knowledge_graph/nexora_knowledge_graph.db
KG_MAX_EXPANSION_DEPTH=6
KG_DEFAULT_PAGE_SIZE=50
KG_MAX_PAGE_SIZE=200
KG_ENABLE_AI_INFERRED_EDGES=true

# Stage 23: IoT Project Builder Engine
IOT_DB_PATH=data/iot_projects/nexora_iot.db
IOT_EXPORTS_DIR=data/iot_projects/exports
IOT_DEFAULT_SIMULATION_TICKS=8
IOT_MAX_SIMULATION_TICKS=32
IOT_ENABLE_TOOLCHAIN_PROBING=true

# Stage 24: Embedded Firmware Engineering Studio
FIRMWARE_DB_PATH=data/firmware_studio/nexora_firmware.db
FIRMWARE_BUILDS_DIR=data/firmware_studio/builds
FIRMWARE_COMPILE_TIMEOUT_SECONDS=15.0
FIRMWARE_MAX_FILE_SIZE_BYTES=262144
FIRMWARE_DEFAULT_BAUD_RATE=115200

# Stage 25: IoT Device Connectivity & Live Telemetry
TELEMETRY_DB_PATH=data/telemetry/nexora_telemetry.db
TELEMETRY_DATASETS_DIR=data/telemetry/datasets
TELEMETRY_MAX_EVENTS_PER_DEVICE=2000
TELEMETRY_RATE_LIMIT_PER_MINUTE=60
TELEMETRY_DEDUP_WINDOW=1000

# Stage 26: IoT Security & Device Threat Detection
IOT_SECURITY_DB_PATH=data/iot_security/nexora_iot_security.db
IOT_SECURITY_BASELINE_WINDOW_EVENTS=50
IOT_SECURITY_AUTH_FAILURE_THRESHOLD=5
IOT_SECURITY_ZSCORE_THRESHOLD=3.0
IOT_SECURITY_RATE_SPIKE_MULTIPLIER=3.0
IOT_SECURITY_NETWORK_ADAPTER_CONFIGURED=false

# Stage 27: Electronic Circuit Schematic Design Studio
SCHEMATIC_DB_PATH=data/schematics/nexora_schematics.db
SCHEMATIC_EXPORTS_DIR=data/schematics/exports
SCHEMATIC_MAX_COMPONENTS_PER_SHEET=250
SCHEMATIC_MAX_NETS_PER_SHEET=500
SCHEMATIC_SPICE_SIMULATION_TIMEOUT_SECONDS=10.0
SCHEMATIC_ENABLE_ANALYTICAL_SOLVER=true

# Context & Limits
MAX_CONTEXT_MESSAGES=20
MAX_MESSAGE_CHARS=32000
REQUEST_TIMEOUT_SECONDS=45.0

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=60
ENABLE_SAFETY_GUARDRAILS=true
