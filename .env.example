# ==========================================
# NEXORA AI — Environment Configuration Template
# Copy this file to .env and configure your keys.
# ==========================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Provider API Keys (Leave blank if not configured yet; Nexora will report honest unconfigured status)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default Active Model & Provider (gemini | openai | anthropic | offline)
DEFAULT_PROVIDER=unconfigured
DEFAULT_MODEL=gemini-1.5-flash

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=60
ENABLE_SAFETY_GUARDRAILS=true
